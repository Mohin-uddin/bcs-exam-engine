# Application Port
PORT=3000
NODE_ENV=development

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://bcs_admin:secure_password@localhost:5432/bcs_prep_db?schema=public"

# Redis Cache & Sorted Sets Leaderboard
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Google Gemini API (For Current Affairs Synthesis & Mnemonic Enrichment)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Vision OMR Microservice Endpoint (FastAPI / OpenCV)
OMR_SERVICE_URL="http://localhost:8000"

# Online payment gateway (bKash, Nagad, Rocket, Upay, cards). Pick one: sslcommerz | aamarpay
PAYMENT_GATEWAY="sslcommerz"
# true = sandbox/test (no real money). Set false only with LIVE credentials.
PAYMENT_SANDBOX="true"
SSLCOMMERZ_STORE_ID="your_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_store_password"
AAMARPAY_STORE_ID=""
AAMARPAY_SIGNATURE_KEY=""
# Your public website address, used for the gateway's success / fail / IPN callback URLs
PUBLIC_URL="https://your-app.onrender.com"
ADMIN_KEY="change-this-strong-admin-key"

# Cash on Delivery order OTP (SMS). android | bulksmsbd | smsnetbd | console (testing: OTP only in the server log)
# android = your own phone + SIM with the free "SMS Gateway for Android" app (cheapest, see deploy/oracle/README.md)
# Leave SMS_PROVIDER empty to use the phone app login typed in /admin -> "OTP SMS"
SMS_PROVIDER=""
SMS_GATEWAY_USER=""
SMS_GATEWAY_PASSWORD=""
SMS_API_KEY=""
# Approved sender ID / masking from the SMS company (required for bulksmsbd)
SMS_SENDER_ID=""
